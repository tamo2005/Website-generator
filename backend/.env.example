# ──────────────────────────────────────────────────────
# AI Website Generator — Backend Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# OpenRouter API key (free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=or_your_key_here

# OpenRouter model slug
# Recommended: moonshotai/kimi-k2.6:free
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free

# Optional OpenRouter metadata headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Website Generator

# Enable model reasoning tokens in OpenRouter
OPENROUTER_REASONING_ENABLED=false

# Path to the generated Tailwind stylesheet used by preview/export
PREVIEW_CSS_PATH=../frontend/public/preview-tailwind.css

# Max tokens to generate
MAX_NEW_TOKENS=2048

# CORS allowed origin (your frontend URL)
ALLOWED_ORIGIN=http://localhost:3000

# Max prompt length in characters
MAX_PROMPT_CHARS=8000

# Temperature (QwQ recommendation: 0.6)
TEMPERATURE=0.6

# Sampling controls recommended by the model card
TOP_P=0.95
TOP_K=40
REPETITION_PENALTY=1.05
