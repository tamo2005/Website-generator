# ──────────────────────────────────────────────────────
# AI Website Generator — Backend Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# HuggingFace API token (free at https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Model to use
# Recommended: Qwen/QwQ-32B
MODEL_ID=Qwen/QwQ-32B

# Max tokens to generate
MAX_NEW_TOKENS=2048

# CORS allowed origin (your frontend URL)
ALLOWED_ORIGIN=http://localhost:3000

# Max prompt length in characters
MAX_PROMPT_CHARS=8000

# Temperature (QwQ recommendation: 0.6)
TEMPERATURE=0.6

# Sampling controls recommended by the model card
TOP_P=0.95
TOP_K=40
REPETITION_PENALTY=1.05
