# ──────────────────────────────────────────────────────────────
# AI Website Generator — Backend Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Application Profile ──────────────────────────────────────
# Options: development | staging | production
APP_PROFILE=development

# ── Database (PostgreSQL via asyncpg) ────────────────────────
# Docker Compose: postgresql+asyncpg://wg_user:wg_pass@localhost:5432/website_generator
# Neon/Supabase:  postgresql+asyncpg://<user>:<pass>@<host>/<db>
DATABASE_URL=postgresql+asyncpg://wg_user:wg_pass@localhost:5432/website_generator

# ── Redis ────────────────────────────────────────────────────
# Docker Compose: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ───────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ──────────────────────────────────────────
# Get a free key at https://resend.com
# Leave empty to skip email sending in development
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── OAuth — Google ──────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# ── OAuth — GitHub ──────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ── AI Providers ─────────────────────────────────────────────

# Default provider: openrouter | gemini | ollama
DEFAULT_PROVIDER=openrouter

# OpenRouter (primary cloud — free models available)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Website Generator
OPENROUTER_REASONING_ENABLED=false

# Gemini (secondary cloud — generous free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local — zero cost, offline, RTX 3050 compatible)
# Install: https://ollama.ai — then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (stubbed — future Phase 3)
OPENAI_API_KEY=

# Anthropic (stubbed — future Phase 3)
ANTHROPIC_API_KEY=

# ── Generation Settings ─────────────────────────────────────
TEMPERATURE=0.6
TOP_P=0.95
MAX_NEW_TOKENS=4096

# ── Pipeline ─────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=2
PIPELINE_VERSION=V1

# ── AI Cache ─────────────────────────────────────────────────
# Off by default in dev — easier to debug without cache
ENABLE_AI_CACHE=false
AI_CACHE_TTL_SECONDS=3600

# ── Feature Flags ────────────────────────────────────────────
ENABLE_COMPONENTS=true
ENABLE_HTML_VALIDATOR=true
ENABLE_VALIDATOR_ACCESSIBILITY=true
ENABLE_VALIDATOR_SEO=true
ENABLE_VALIDATOR_SECURITY=true
ENABLE_VALIDATOR_PERFORMANCE=true
ENABLE_VALIDATOR_BEST_PRACTICES=true
ENABLE_REPAIR=true
ENABLE_METRICS=true
ENABLE_PIPELINE_EVENTS=true
ENABLE_MEMORY=false
ENABLE_EXPORT_REACT=false
ENABLE_EXPORT_VUE=false
ENABLE_EXPORT_NEXTJS=false

# ── Application ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001
MAX_PROMPT_CHARS=8000

# ── CSS Preview ──────────────────────────────────────────────
PREVIEW_CSS_PATH=../frontend/public/preview-tailwind.css
