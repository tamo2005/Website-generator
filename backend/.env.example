# ──────────────────────────────────────────────────────────────
# AI Website Generator — Backend Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/website_generator

# ── JWT Authentication ───────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ──────────────────────────────────────────
# Get a free API key at https://resend.com
# Leave empty to log emails to console (development mode)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── OAuth — Google ──────────────────────────────────────────
# Create an OAuth app at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ── OAuth — GitHub ──────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback

# ── OpenRouter (LLM) ───────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Website Generator
OPENROUTER_REASONING_ENABLED=false

# ── Generation Settings ─────────────────────────────────────
MAX_NEW_TOKENS=2048
TEMPERATURE=0.6
TOP_P=0.95

# ── Application ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001
MAX_PROMPT_CHARS=8000
